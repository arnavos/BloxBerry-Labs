# Required: Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Path to JSON state file (set to /var/data/bloxberry_data.json on Render if persistent disk is attached)
DATA_FILE=bloxberry_data.json

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Slash command sync behavior:
# - auto: sync only when the command tree definition hash changes (recommended)
# - always: sync on startup
# - never: skip automatic syncing
SYNC_COMMANDS_MODE=auto

# Optional: Restrict slash command sync to a single Guild ID for instant updates during development
# DISCORD_GUILD_ID=123456789012345678

# Minimum debounce delay (seconds, >= 0.1) before refreshing/editing panel embeds
PANEL_REFRESH_DEBOUNCE_SECONDS=2.5

# Max seconds discord.py waits internally on a rate limit bucket before raising HTTPException/RateLimited
# Use a number >= 30.0 or "none" to wait indefinitely
MAX_RATELIMIT_TIMEOUT=60.0

# Exponential backoff settings for outer startup/gateway/429 recovery (seconds)
RETRY_BASE_DELAY_SECONDS=60
RETRY_MAX_DELAY_SECONDS=900

# Single-instance advisory file lock path (prevents duplicate local/worker processes)
# Set to "", "none", "off", or "false" to disable
INSTANCE_LOCK_FILE=.bloxberry_bot.lock

# Port for Render HTTP health check server (default 10000)
PORT=10000
